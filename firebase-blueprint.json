{
  "entities": {
    "InventoryItem": {
      "title": "Inventory Item",
      "description": "Represents a physical book or stationery item in stock",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["Book", "Stationery", "Electronics", "Other"] },
        "version": { "type": "string", "enum": ["Bangla", "English", "N/A"] },
        "program": { "type": "string", "enum": ["Class 6", "Class 7", "Class 8", "Class 9", "Class 10", "Class 11", "Class 12", "Medical", "Engineering", "Varsity A", "Varsity B", "Custom"] },
        "subProgram": { "type": "string" },
        "stockLevel": { "type": "number" },
        "unit": { "type": "string" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "version", "stockLevel", "unit", "lastUpdated"]
    },
    "Branch": {
      "title": "Branch",
      "description": "Represents one of the 115 coaching center branches",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "location": { "type": "string" }
      },
      "required": ["name", "location"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Represents a single stock movement (In/Out)",
      "type": "object",
      "properties": {
        "itemId": { "type": "string" },
        "itemName": { "type": "string" },
        "itemVersion": { "type": "string" },
        "type": { "type": "string", "enum": ["Stock In", "Stock Out"] },
        "quantity": { "type": "number" },
        "voucherNumber": { "type": "string" },
        "recipient": { "type": "string", "enum": ["Office", "Teacher", "Student", "Other"] },
        "recipientName": { "type": "string" },
        "branchId": { "type": "string" },
        "branchName": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "note": { "type": "string" }
      },
      "required": ["itemId", "itemName", "itemVersion", "type", "quantity", "voucherNumber", "branchId", "branchName", "date"]
    }
  },
  "firestore": {
    "/items/{itemId}": {
      "schema": "InventoryItem",
      "description": "Collection of all inventory items"
    },
    "/branches/{branchId}": {
      "schema": "Branch",
      "description": "Collection of all coaching center branches"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Log of all stock movements"
    }
  }
}
